---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/posts';
import { fmtDate, url, tempsLecture } from '../../lib/util';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({ params: { slug: note.id }, props: { note, prev: notes[i + 1], next: notes[i - 1] } }));
}
const { note, prev, next } = Astro.props;
const { Content } = await render(note);
const d = note.data;
---
<Base title={d.title} description={d.resume}>
  <article>
    <p class="muted small cap"><a href={url('/notes')}>Notes</a> · {fmtDate(d.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })} · {tempsLecture(note.body)} min</p>
    <h1>{d.title}</h1>
    {d.sources.length > 0 && <p class="muted">Lu dans : {d.sources.join(', ')}</p>}
    {d.tags.length > 0 && <p>{d.tags.map((t) => <span class="tag">#{t}</span>)}</p>}
    <div class="prose"><Content /></div>
  </article>
  <nav class="pn">
    {prev ? <a href={url(`/notes/${prev.id}`)}>← {prev.data.title}</a> : <span />}
    {next ? <a href={url(`/notes/${next.id}`)}>{next.data.title} →</a> : <span />}
  </nav>
</Base>
<style>
  .cap::first-letter { text-transform: uppercase; }
  article { padding-top: 24px; }
  .pn { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); }
</style>
