---
import '../styles/global.css';
import { SITE, BANDEAU } from '../config';
import { url } from '../lib/util';
import Ticker from '../components/Ticker.astro';

interface Props { title?: string; description?: string }
const { title, description = SITE.sousTitre } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.titre}` : SITE.titre;
const path = Astro.url.pathname;
const actif = (p: string) => (path.startsWith(url(p)) ? 'actif' : '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.titre} href={url('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Ticker symboles={BANDEAU} />
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={url('/')}>
          <span class="logo-mark">◆</span> {SITE.titre}
        </a>
        <nav>
          <a class={actif('/notes')} href={url('/notes')}>Notes</a>
          <a class={actif('/analyses')} href={url('/analyses')}>Analyses</a>
          <a class={actif('/marches')} href={url('/marches')}>Marchés</a>
          <a class={actif('/actualites')} href={url('/actualites')}>Actualités</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer muted small">
      <p>
        © {new Date().getFullYear()} {SITE.auteur} · Données : CoinGecko (cryptos, temps réel), Yahoo Finance (indices, mis à jour
        plusieurs fois par jour), flux RSS des éditeurs cités. Rien ici ne constitue un conseil en investissement.
      </p>
      <p><a href={url('/rss.xml')}>Flux RSS</a></p>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 16px; padding-bottom: 16px; flex-wrap: wrap; }
  .logo { font-family: var(--serif); font-weight: 700; font-size: 1.35rem; color: var(--ink); text-decoration: none; }
  .logo-mark { color: var(--accent); }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { color: var(--ink); padding: 6px 12px; border-radius: 999px; font-weight: 500; font-size: 0.95rem; }
  nav a:hover { background: var(--line); text-decoration: none; }
  nav a.actif { background: var(--ink); color: var(--bg); }
  main { min-height: 60vh; padding-bottom: 48px; }
  .site-footer { border-top: 1px solid var(--line); padding-top: 16px; padding-bottom: 32px; }
</style>
